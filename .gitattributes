# Line endings are pinned rather than left to core.autocrlf. Without this, a clone on a
# machine with autocrlf=true rewrites every file on checkout, which turns the next commit
# into a whole-repository diff and makes a real change impossible to see in review.
* text=auto eol=lf

# Binary, and byte-identical is the point: the icon is generated by tools/make_icon.py and
# the password filter by tools/make_breach_filter.py, and a filter rewritten by a line-ending
# rule would stop matching the offsets the reader computes.
*.ico binary
*.rgba binary
*.bloom binary
*.exe binary

# PowerShell reads a UTF-8 script fine either way, but a .cmd with LF endings is executed
# line by line by cmd.exe and breaks on the first continuation.
*.cmd text eol=crlf
